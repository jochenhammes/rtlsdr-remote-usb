# Kopiert nach /etc/default/rtlsdr-usbip-client (macht install.sh automatisch).

# Pflicht: Hostname oder IP des USB/IP-Servers.
RTLSDR_SERVER_HOST=

# Optional: feste busid (z.B. 1-1.4) statt automatischer Erkennung über die
# Vendor:Product-ID des RTL-SDR-Dongles. Nur nötig, wenn mehrere USB/IP-Geräte
# auf dem Server exportiert werden und die Auto-Erkennung mehrdeutig wäre.
#RTLSDR_BUSID=1-1.4

# Sekunden zwischen Verbindungsprüfungen.
#RTLSDR_POLL_INTERVAL=5

# Maximales Backoff-Intervall (Sekunden) zwischen Reconnect-Versuchen.
#RTLSDR_MAX_BACKOFF=60

# Log-Level: DEBUG, INFO, WARNING, ERROR
#RTLSDR_LOG_LEVEL=INFO
